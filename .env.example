# Copy to .env for local development (`npm run server` + `npm start`).
# On Vercel, set the same variables in Project Settings > Environment Variables.

# Firebase service account (Firebase console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with literal \n sequences, wrapped in double quotes
FIREBASE_PRIVATE_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the Gemini model (defaults to gemini-flash-latest)
# GEMINI_MODEL=

# Optional: only needed for the /api/v1/auth endpoints
# JWT_SECRET=

# Optional: point the frontend at an API on another host. Leave unset to use /api.
# REACT_APP_API_URL=
